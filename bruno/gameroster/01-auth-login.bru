meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{publishableKey}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.access_token);
  bru.setEnvVar("userId", res.body.user.id);
}
